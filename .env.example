VITE_LLM_PROVIDER=mock # Options: openai, gemini, bedrock, bedrock-agent, ollama

# OpenAI Settings
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_MODEL=gpt-4o # Optional

# Gemini Settings
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-1.5-pro # Optional

# AWS Bedrock Settings (Both Agent and Standard)
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
VITE_AWS_REGION=us-east-1

# Standard Bedrock Settings
VITE_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0 # e.g. anthropic.claude-3-sonnet-20240229-v1:0

# Bedrock Agent Settings
VITE_BEDROCK_AGENT_ID=your_agent_id
VITE_BEDROCK_AGENT_ALIAS_ID=your_agent_alias_id
VITE_BEDROCK_SESSION_ID=local-session-1

# Ollama Settings (Local AI)
VITE_OLLAMA_URL=http://localhost:11434/v1
VITE_OLLAMA_MODEL=qwen2.5-coder:3b # e.g. llama3, mistral, phi3
